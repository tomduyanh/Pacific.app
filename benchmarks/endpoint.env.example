# Copy to benchmarks/endpoint.env (gitignored) and fill in. The API key is NOT
# stored here: set BENCH_API_KEY as an environment secret.

# 1 = the endpoint speaks OpenAI-compatible chat completions (e.g. vLLM);
#     the harness runs benchmarks/adapter.py in front of it.
# 0 = the endpoint implements benchmarks/ENDPOINT_SPEC.md (Gemini format)
#     directly; set BENCH_GEMINI_BASE to it.
BENCH_USE_ADAPTER=1
BENCH_GEMINI_BASE=

# Adapter: chat/vision model (OpenAI-compatible base URL, ending in /v1).
BENCH_UPSTREAM_URL=
BENCH_UPSTREAM_MODEL=
# Adapter: embedding model. Leave the URL empty if it is served by the same
# gateway as the chat model.
BENCH_UPSTREAM_EMBED_URL=
BENCH_UPSTREAM_EMBED_MODEL=
# Qwen3-style models: 1 turns thinking off (recommended for Pacific's prompts).
BENCH_DISABLE_THINKING=1

# Vector length the embedding model returns.
BENCH_EMBED_DIM=
