# Copy to benchmarks/endpoint.env (gitignored) and fill in once the custom
# endpoint is live. The API key is NOT stored here: set BENCH_API_KEY as an
# environment secret.

# Base URL Pacific sends Gemini-format requests to. Either the custom endpoint
# itself (if it implements benchmarks/ENDPOINT_SPEC.md) or, with
# BENCH_USE_ADAPTER=1, left empty: the harness starts benchmarks/adapter.py
# locally and points Pacific at it.
BENCH_GEMINI_BASE=

# Vector length the embedding endpoint returns.
BENCH_EMBED_DIM=

# Model path segments, as they appear in the URL: {base}/{model}:{method}
BENCH_EMBED_MODEL=models/embedding
BENCH_LLM_MODEL=models/text
BENCH_VISION_MODEL=models/vision

# 1 = the endpoint has its own request format; translate through adapter.py.
BENCH_USE_ADAPTER=0

# Adapter only: where the custom API lives.
BENCH_UPSTREAM_URL=
