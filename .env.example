# Embedding & LLM provider: "mock" (default, no API key needed), "gemini", or "anthropic"
EMBEDDING_PROVIDER=mock

# Required when EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Required when EMBEDDING_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Embedding vector dimension (768 for gemini text-embedding-004, 1536 for voyage-3)
EMBED_DIM=768

# Gemini model overrides (optional).
# Default is flash-lite: on this project's extraction prompts, flash-latest
# spent ~191 thinking tokens of its 200-token cap and returned truncated
# answers, was ~4x slower, and 503'd on roughly half of calls.
# GEMINI_LLM_MODEL=models/gemini-flash-lite-latest
# GEMINI_VISION_MODEL=models/gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=models/gemini-embedding-001

# Total live-vision deadline, including provider retries. Discard stalled frames.
# LIVE_SCREEN_MAX_LATENCY_SEC=20
